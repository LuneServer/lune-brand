{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": {
    "name": "Lune",
    "tagline": "Your universe. Your media.",
    "mark": "horizon"
  },
  "color": {
    "palette": {
      "obsidian": { "$value": "#09090B", "$type": "color" },
      "graphite": { "$value": "#141417", "$type": "color" },
      "charcoal": { "$value": "#1E1E22", "$type": "color" },
      "hairline": { "$value": "#2C2C31", "$type": "color" },
      "pureWhite": { "$value": "#FFFFFF", "$type": "color" },
      "lunarSilver": { "$value": "#F5F5F7", "$type": "color" },
      "silverMuted": { "$value": "#A1A1A6", "$type": "color" },
      "silverSubtle": { "$value": "#7C7C82", "$type": "color" },
      "lunarBlue": { "$value": "#64D2FF", "$type": "color" }
    },
    "semantic": {
      "dark": {
        "canvas": { "$value": "{color.palette.obsidian}", "$type": "color" },
        "surface": { "$value": "{color.palette.graphite}", "$type": "color" },
        "elevated": { "$value": "{color.palette.charcoal}", "$type": "color" },
        "border": { "$value": "{color.palette.hairline}", "$type": "color" },
        "textPrimary": { "$value": "{color.palette.lunarSilver}", "$type": "color" },
        "textSecondary": { "$value": "{color.palette.silverMuted}", "$type": "color" },
        "textMuted": { "$value": "{color.palette.silverSubtle}", "$type": "color" },
        "accentPrimary": { "$value": "{color.palette.pureWhite}", "$type": "color" },
        "accentHighlight": { "$value": "{color.palette.lunarSilver}", "$type": "color" },
        "accentTelemetry": { "$value": "{color.palette.lunarBlue}", "$type": "color" },
        "statusHealthy": { "$value": "#30D158", "$type": "color" },
        "statusWarning": { "$value": "#F5C451", "$type": "color" },
        "statusDanger": { "$value": "#FF6961", "$type": "color" }
      },
      "light": {
        "canvas": { "$value": "#F5F5F7", "$type": "color" },
        "surface": { "$value": "#FFFFFF", "$type": "color" },
        "elevated": { "$value": "#E8E8ED", "$type": "color" },
        "textPrimary": { "$value": "#1D1D1F", "$type": "color" },
        "textSecondary": { "$value": "#515154", "$type": "color" },
        "accentPrimary": { "$value": "#1D1D1F", "$type": "color" },
        "accentTelemetry": { "$value": "#0071E3", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Display", "Inter", "Segoe UI", "system-ui", "sans-serif"], "$type": "fontFamily" },
      "ui": { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Inter", "Segoe UI", "system-ui", "sans-serif"], "$type": "fontFamily" },
      "mono": { "$value": ["ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "monospace"], "$type": "fontFamily" }
    },
    "wordmark": {
      "fontFamily": { "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif", "$type": "fontFamily" },
      "fontWeight": { "$value": 600, "$type": "fontWeight" },
      "letterSpacing": { "$value": "-0.025em", "$type": "dimension" }
    }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  }
}
